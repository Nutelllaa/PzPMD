<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/inputTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Назва нотатки"
            android:inputType="textCapSentences"
            android:textSize="18sp"
            android:backgroundTint="@color/purple_main" />

        <EditText
            android:id="@+id/inputDescription"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="18dp"
            android:gravity="top"
            android:hint="Текст нотатки"
            android:inputType="textMultiLine|textCapSentences"
            android:textSize="16sp"
            android:backgroundTint="@color/purple_main" />

        <EditText
            android:id="@+id/inputImageUrl"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:hint="URL зображення"
            android:inputType="textUri"
            android:textSize="16sp"
            android:backgroundTint="@color/purple_main" />

        <EditText
            android:id="@+id/inputLocation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Координати / місце"
            android:inputType="text"
            android:textSize="16sp"
            android:backgroundTint="@color/purple_main" />

        <EditText
            android:id="@+id/inputSubNote"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Пункт нотатки"
            android:inputType="textCapSentences"
            android:textSize="16sp"
            android:backgroundTint="@color/purple_main" />

        <Button
            android:id="@+id/btnAddSubNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Додати пункт"
            android:backgroundTint="@color/purple_main"
            android:textColor="#FFFFFF" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subNotesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:text="Створити"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/purple_main" />

    </LinearLayout>
</ScrollView>
